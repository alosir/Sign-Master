<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cycle_label"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/quickCycleChipGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chipDaily"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checkable="true"
            android:text="@string/cycle_quick_daily"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chipWeekly"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checkable="true"
            android:text="@string/cycle_quick_weekly"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chipMonthly"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checkable="true"
            android:text="@string/cycle_quick_monthly"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chipCustom"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checkable="true"
            android:text="@string/cycle_custom"
            android:textSize="13sp" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- 自定义：每 N [天/周/月] -->
    <LinearLayout
        android:id="@+id/customCycleContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cycle_every_prefix"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp" />

        <NumberPicker
            android:id="@+id/cycleValuePicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:descendantFocusability="blocksDescendants" />

        <NumberPicker
            android:id="@+id/cycleUnitPicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:descendantFocusability="blocksDescendants" />

    </LinearLayout>

    <!-- 每周：周一 ~ 周日多选 -->
    <android.widget.GridLayout
        android:id="@+id/weekDayChipGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:columnCount="7"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chipMon"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:checkable="true"
            android:paddingHorizontal="0dp"
            android:text="@string/cycle_monday"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chipTue"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:checkable="true"
            android:paddingHorizontal="0dp"
            android:text="@string/cycle_tuesday"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chipWed"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:checkable="true"
            android:paddingHorizontal="0dp"
            android:text="@string/cycle_wednesday"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chipThu"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:checkable="true"
            android:paddingHorizontal="0dp"
            android:text="@string/cycle_thursday"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chipFri"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:checkable="true"
            android:paddingHorizontal="0dp"
            android:text="@string/cycle_friday"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chipSat"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:checkable="true"
            android:paddingHorizontal="0dp"
            android:text="@string/cycle_saturday"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chipSun"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="2dp"
            android:checkable="true"
            android:paddingHorizontal="0dp"
            android:text="@string/cycle_sunday"
            android:textSize="13sp" />

    </android.widget.GridLayout>

    <!-- 每月：1-31 + 最后一天 -->
    <android.widget.GridLayout
        android:id="@+id/monthDayChipGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:columnCount="7"
        android:visibility="gone">

        <!-- 由代码动态生成 1-31 + 最后一天 -->

    </android.widget.GridLayout>

    <CheckBox
        android:id="@+id/checkSkipHolidays"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/cycle_skip_holidays" />

    <CheckBox
        android:id="@+id/checkSkipWeekends"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cycle_skip_weekends" />

    <TextView
        android:id="@+id/cycleDescriptionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="?attr/colorPrimary"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
